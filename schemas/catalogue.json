{
  "$id": "catalogue",
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Firmware Catalogue",
  "description": "",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "./catalogue-version.json"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "./product.json"
      },
      "minItems": 1
    },
    "firmwares": {
      "type": "array",
      "description": "",
      "items": {
        "$ref": "./firmware.json"
      },
      "minItems": 1
    },
    "advisories": {
      "type": "array",
      "items": {
        "$ref": "./advisory.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "firmwares"
  ]
}

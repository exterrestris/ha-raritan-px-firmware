{
  "$id": "advisory",
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "issue": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "affects": {
      "type": "array",
      "items": {
        "$ref": "./firmware-version.json"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fixed_in": {
      "$ref": "./firmware-version.json"
    }
  },
  "required": [
    "issue",
    "affects"
  ]
}
